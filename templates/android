    private fun carregarAppComIP(endereco: String) {
        val idSala = prefs.getString("ID_SALA", "001")
        val cleanEndereco = endereco.trim()
        // Se o campo estiver vazio, usa o seu link padrão da DigitalOcean
        val urlBase = when {
            cleanEndereco.isEmpty() -> "https://vendasonline-jpqa8.ondigitalocean.app"
            cleanEndereco.startsWith("http") -> cleanEndereco
            cleanEndereco.contains(".") -> "https://$cleanEndereco"
            else -> "http://$cleanEndereco:5001"
        }

        val urlFinal = "$urlBase/?id_sala=$idSala"

        Log.d("URL_CONFIG", "Carregando: $urlFinal")
        webView.loadUrl(urlFinal)
    }
