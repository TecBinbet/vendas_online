    inner class PonteImpressora(private val mContext: Context) {

        @JavascriptInterface
        fun obterDispositivosBluetooth(): String {
            val bluetoothManager = mContext.getSystemService(Context.BLUETOOTH_SERVICE) as BluetoothManager
            val bluetoothAdapter = bluetoothManager.adapter

            if (bluetoothAdapter == null || !bluetoothAdapter.isEnabled) {
                return "DESLIGADO"
            }

            @SuppressLint("MissingPermission")
            val pairedDevices = bluetoothAdapter.bondedDevices
            val listaJson = JSONArray()

            pairedDevices.forEach { device ->
                @SuppressLint("MissingPermission")
                val nome = device.name
                if (nome != null) {
                    listaJson.put(nome)
                }
            }
            return listaJson.toString()
        }

        @JavascriptInterface
        fun imprimirRecibo(conteudoRecibo: String, nomeImpressora: String) {
            Thread {
                try {
                    val bluetoothManager = mContext.getSystemService(Context.BLUETOOTH_SERVICE) as BluetoothManager
                    val bluetoothAdapter = bluetoothManager.adapter

                    if (bluetoothAdapter == null || !bluetoothAdapter.isEnabled) {
                        runOnUiThread { Toast.makeText(mContext, "Bluetooth desligado!", Toast.LENGTH_SHORT).show() }
                        return@Thread
                    }

                    @SuppressLint("MissingPermission")
                    val pairedDevices = bluetoothAdapter.bondedDevices
                    val printerDevice = pairedDevices.find { it.name == nomeImpressora }

                    if (printerDevice != null) {
                        val uuid = UUID.fromString("00001101-0000-1000-8000-00805F9B34FB")

                        @SuppressLint("MissingPermission")
                        val socket = printerDevice.createRfcommSocketToServiceRecord(uuid)

                        socket.connect()
                        val outputStream = socket.outputStream

                        outputStream.write(byteArrayOf(0x1B, 0x40))
                        outputStream.write(conteudoRecibo.toByteArray(Charsets.ISO_8859_1))
                        outputStream.write(byteArrayOf(0x0A, 0x0A, 0x0A))

                        outputStream.flush()
                        socket.close()

                    } else {
                        runOnUiThread { Toast.makeText(mContext, "Impressora $nomeImpressora não encontrada.", Toast.LENGTH_LONG).show() }
                    }
                } catch (e: Exception) {
                    e.printStackTrace()
                    runOnUiThread { Toast.makeText(mContext, "Erro ao imprimir: ${e.message}", Toast.LENGTH_LONG).show() }
                }
            }.start()
        }

        @JavascriptInterface
        fun imprimirReciboJson(pacoteJsonStr: String, nomeImpressora: String) {
            Thread {
                try {
                    val bluetoothManager = mContext.getSystemService(Context.BLUETOOTH_SERVICE) as BluetoothManager
                    val bluetoothAdapter = bluetoothManager.adapter

                    if (bluetoothAdapter == null || !bluetoothAdapter.isEnabled) {
                        runOnUiThread { Toast.makeText(mContext, "Bluetooth desligado!", Toast.LENGTH_SHORT).show() }
                        return@Thread
                    }

                    @SuppressLint("MissingPermission")
                    val pairedDevices = bluetoothAdapter.bondedDevices
                    val printerDevice = pairedDevices.find { it.name == nomeImpressora }

                    if (printerDevice != null) {
                        val uuid = UUID.fromString("00001101-0000-1000-8000-00805F9B34FB")

                        @SuppressLint("MissingPermission")
                        val socket = printerDevice.createRfcommSocketToServiceRecord(uuid)
                        socket.connect()
                        val outputStream = socket.outputStream

                        outputStream.write(byteArrayOf(0x1B, 0x40))

                        val pacote = org.json.JSONObject(pacoteJsonStr)
                        var avancoLinhas = 3
                        if (pacote.has("config")) {
                            val config = pacote.getJSONObject("config")
                            avancoLinhas = config.optInt("avanco_linhas", 3)
                        }

                        if (pacote.has("linhas")) {
                            val linhasArray = pacote.getJSONArray("linhas")

                            for (i in 0 until linhasArray.length()) {
                                val linhaObj = linhasArray.getJSONObject(i)
                                val texto = linhaObj.optString("texto", "")
                                val alinhamento = linhaObj.optString("alinhamento", "esquerda")
                                val tamanho = linhaObj.optString("tamanho", "normal")
                                val negrito = linhaObj.optBoolean("negrito", false)

                                when (alinhamento) {
                                    "centro" -> outputStream.write(byteArrayOf(0x1B, 0x61, 0x01))
                                    "direita" -> outputStream.write(byteArrayOf(0x1B, 0x61, 0x02))
                                    else -> outputStream.write(byteArrayOf(0x1B, 0x61, 0x00))
                                }

                                if (negrito) outputStream.write(byteArrayOf(0x1B, 0x45, 0x01))
                                else outputStream.write(byteArrayOf(0x1B, 0x45, 0x00))

                                when (tamanho) {
                                    "duplo" -> outputStream.write(byteArrayOf(0x1D, 0x21, 0x11))
                                    "altura" -> outputStream.write(byteArrayOf(0x1D, 0x21, 0x01))
                                    "largura" -> outputStream.write(byteArrayOf(0x1D, 0x21, 0x10))
                                    "medio" -> outputStream.write(byteArrayOf(0x1D, 0x21, 0x01))
                                    else -> outputStream.write(byteArrayOf(0x1D, 0x21, 0x00))
                                }

                                outputStream.write(texto.toByteArray(Charsets.ISO_8859_1))
                                outputStream.write(byteArrayOf(0x0A))
                            }
                        }

                        for (i in 0 until avancoLinhas) outputStream.write(byteArrayOf(0x0A))

                        outputStream.flush()
                        socket.close()

                    } else {
                        runOnUiThread { Toast.makeText(mContext, "Impressora $nomeImpressora não encontrada.", Toast.LENGTH_LONG).show() }
                    }
                } catch (e: Exception) {
                    e.printStackTrace()
                    runOnUiThread { Toast.makeText(mContext, "Erro JSON: ${e.message}", Toast.LENGTH_LONG).show() }
                }
            }.start()
        }

        @JavascriptInterface
        fun chamarTelaDeIP() {
            runOnUiThread { mostrarDialogoDeIP() }
        }
    }

    @SuppressLint("SetJavaScriptEnabled")
    override fun onCreate(savedInstanceState: Bundle?) {
        private lateinit var webView: WebView // Declara a variável aqui

        override fun onCreate(savedInstanceState: Bundle?) {
            super.onCreate(savedInstanceState)
            setContentView(R.layout.activity_main)

            webView = findViewById(R.id.webView)

        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        prefs = getSharedPreferences("ConfigApp", Context.MODE_PRIVATE)
        myWebView = findViewById(R.id.webview)

        val permissionsNeeded = mutableListOf(Manifest.permission.CAMERA)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
            permissionsNeeded.add(Manifest.permission.BLUETOOTH_CONNECT)
        }

        val missingPermissions = permissionsNeeded.filter {
            ContextCompat.checkSelfPermission(this, it) != PackageManager.PERMISSION_GRANTED
        }

        if (missingPermissions.isNotEmpty()) {
            ActivityCompat.requestPermissions(this, missingPermissions.toTypedArray(), PERMISSION_CODE)
        }

        WebView.setWebContentsDebuggingEnabled(true)
        myWebView.addJavascriptInterface(PonteImpressora(this), "AndroidTerminal")

        myWebView.webChromeClient = object : WebChromeClient() {
            override fun onPermissionRequest(request: PermissionRequest?) {
                request?.grant(request.resources)
            }
        }

        myWebView.webViewClient = object : WebViewClient() {
            @SuppressLint("WebViewClientOnReceivedSslError")
            override fun onReceivedSslError(view: WebView?, handler: SslErrorHandler?, error: SslError?) {
                handler?.proceed()
            }

            override fun onReceivedError(view: WebView?, request: WebResourceRequest?, error: WebResourceError?) {
                val errorMessage = "<html><body style='background-color:#1e1e1e;color:white;padding:30px;font-family:sans-serif;text-align:center;'>" +
                        "<h2>Servidor Não Encontrado</h2>" +
