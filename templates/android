    private fun mostrarDialogoDeIP() {
        val builder = AlertDialog.Builder(this)
        builder.setTitle("Configuração do Sistema")
        builder.setMessage("Preencha o endereço do servidor e o ID da Sala:")

        // Criando uma "caixa" (Layout) para colocar os dois campos de texto
        val layout = LinearLayout(this)
        layout.orientation = LinearLayout.VERTICAL
        val params = LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT)
        params.setMargins(50, 0, 50, 0)
        layout.layoutParams = params

        // Campo 1: IP ou Domínio
        val inputIp = EditText(this)
        inputIp.hint = "IP/Site (ex: 192.168.1.35)"
        inputIp.inputType = android.text.InputType.TYPE_CLASS_TEXT
        inputIp.setText(prefs.getString("IP_SERVIDOR", ""))
        layout.addView(inputIp)

        // Campo 2: ID da Sala
        val inputSala = EditText(this)
        inputSala.hint = "ID da Sala (ex: 001)"
        inputSala.inputType = android.text.InputType.TYPE_CLASS_TEXT
        inputSala.setText(prefs.getString("ID_SALA", "001"))
        layout.addView(inputSala)

        builder.setView(layout)

        builder.setPositiveButton("Salvar e Conectar") { dialog, _ ->
            val novoIp = inputIp.text.toString().trim()
            val novaSala = inputSala.text.toString().trim()

            if (novoIp.isNotEmpty() && novaSala.isNotEmpty()) {
                // Guarda os dois no caderninho
                prefs.edit()
                    .putString("IP_SERVIDOR", novoIp)
                    .putString("ID_SALA", novaSala)
                    .apply()
                carregarAppComIP(novoIp)
                dialog.dismiss()
            } else {
                Toast.makeText(this, "Por favor, preencha ambos os campos!", Toast.LENGTH_SHORT).show()
                mostrarDialogoDeIP() // Chama a tela de novo se deixou em branco
            }
        }

        builder.setCancelable(false)
        builder.show()
    }

